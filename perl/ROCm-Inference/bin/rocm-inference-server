#!/usr/bin/perl
# rocm-inference-server: an OpenAI-compatible chat server (/v1/chat/completions, streamed as server-sent events)
# and /v1/embeddings, on a unix socket behind nginx: one model (--model), or the models of a directory, each loaded
# when a request names it (--models-dir). See the POD at the end, or --help.
use strict;
use warnings;

use Getopt::Long qw(GetOptions);
use List::Util qw(max);
use File::Basename qw(basename);
use B ();
use JSON::PP ();
use MIME::Base64 qw(encode_base64 decode_base64);
use Pod::Usage qw(pod2usage);
use Time::HiRes ();
use ROCm::Inference qw(:all);
use ROCm::Inference::Log;
use ROCm::Inference::Store qw(store_evict store_usage);
use ROCm::Inference::Multipart;
use Web::Route;

my %o = (listen => './rocm-inference.sock', max_tokens => 0, 'models-margin' => 4, 'kv-budget' => 16,
         'thinking-low' => 2048, 'thinking-medium' => 8192, 'thinking-high' => 0, 'store-max' => 16);  # thinking budgets by reasoning_effort (0: none)
GetOptions(\%o, 'model=s', 'models-dir=s', 'models-max=i', 'models-margin=f', 'kv-budget=f', 'listen=s', 'mode=s', 'ctx=i',
           'name=s', 'draft=s', 'store=s', 'max_tokens=i', 'swa-ring=i', 'stage=s', 'recache', 'kv-type=s',
           'parallel=i', 'prefill-chunk=i', 'embedding-model=s', 'embedding-name=s', 'thinking!', 'preserve-thinking!', 'log!', 'log-level=s', 'log-format=s', 'log-color=s',
           'thinking-low=i', 'thinking-medium=i', 'thinking-high=i',
           'store-max=f', 'store-snapshots=s', 'store-snapshot-every=i', 'debug-stream!', 'mmproj=s', 'whisper=s', 'tts=s', 'tts-codec=s', 'voices=s', 'sd=s', 'minimax=s', 'help')
    or pod2usage(2);
# The log: --nolog is level none; --log-level, --log-format, --log-color are checked by the formatter
our $LOG = eval { ROCm::Inference::Log->new(level => ($o{log} // 1) ? ($o{'log-level'} // 'info') : 'none',
                                              format => $o{'log-format'} // 'text', color => $o{'log-color'} // 'auto') }
    or die "--log-level, --log-format, --log-color: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r) . "\n";
pod2usage(-verbose => 2, -exitval => 0) if $o{help};
pod2usage("--model, --models-dir, --whisper, --tts, --sd or --minimax is required\n") unless $o{model} || $o{'models-dir'} || $o{whisper} || $o{tts} || $o{sd} || $o{minimax};
ROCm::Inference::_require_minijinja()
    or die "rocm-inference-server needs the Minijinja module $ROCm::Inference::MINIJINJA_VERSION\n";
my $no_draft = ($o{draft} // '') eq 'none';  # (no draft head, not even a model's own MTP block)
delete $o{draft} if $no_draft;
die "--draft goes with --model\n" if $o{draft} && !$o{model};
die "--models-dir: no directory $o{'models-dir'}\n" if $o{'models-dir'} && !-d $o{'models-dir'};
my $parallel = $o{parallel} // 1;
die "--parallel N: 1 or more\n" if $parallel < 1;
$o{'store-snapshots'} //= 'lazy';
die "--store-snapshots: lazy or eager\n" unless $o{'store-snapshots'} =~ /\A(?:lazy|eager)\z/;
die "--store-snapshot-every N: 0 or more\n" if ($o{'store-snapshot-every'} // 4) < 0;
die "--parallel: not with --draft (speculative decoding is single-sequence)\n" if $parallel > 1 && $o{draft};
die "--mmproj: no file $o{mmproj}\n" if $o{mmproj} && !-f $o{mmproj};
die "--whisper: no file $o{whisper}\n" if $o{whisper} && !-f $o{whisper};
# the speech model (--whisper, a Whisper GGUF): /v1/audio/transcriptions; the model's name is its file name
my $WHISPER = $o{whisper} ? eval { whisper_load($o{whisper}) } : undef;
die "--whisper $o{whisper}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r) . "\n" if $o{whisper} && !$WHISPER;
my $whisper_name = $o{whisper} ? basename($o{whisper}) =~ s/\.gguf\z//r : undef;
# the speech synthesis (--tts TALKER.gguf --tts-codec CODEC.gguf --voices DIR): /v1/audio/speech; a voice is a directory
# under DIR (tools/qwen3tts_voice.py writes one)
die "--tts needs --tts-codec\n" if $o{tts} && !$o{'tts-codec'};
die "--tts: no file $o{tts}\n" if $o{tts} && !-f $o{tts};
die "--tts-codec: no file $o{'tts-codec'}\n" if $o{'tts-codec'} && !-f $o{'tts-codec'};
die "--voices: no directory $o{voices}\n" if $o{voices} && !-d $o{voices};
my $TTS = $o{tts} ? eval { speech_load($o{tts}, $o{'tts-codec'}) } : undef;
die "--tts $o{tts}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r) . "\n" if $o{tts} && !$TTS;
my $tts_name = $o{tts} ? basename($o{tts}) =~ s/\.gguf\z//r : undef;
# the image model (--sd FILE.gguf, rocm-convert of a diffusers pipeline such as sd-turbo): /v1/images/generations
die "--sd: no file $o{sd}\n" if $o{sd} && !-f $o{sd};
my $IMAGE = $o{sd} ? eval { sd_load($o{sd}) } : undef;
die "--sd $o{sd}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r) . "\n" if $o{sd} && !$IMAGE;
my $sd_name = $o{sd} ? basename($o{sd}) =~ s/\.gguf\z//r : undef;
# the MiniMax-H3-Image pipeline (--minimax DIR: the four GGUFs of ROCm::Inference::MiniMaxImage); its name is "minimax-h3-image"
die "--minimax $o{minimax}: not a directory\n" if $o{minimax} && !-d $o{minimax};
my $MINIMAX = $o{minimax} ? eval { ROCm::Inference::MiniMaxImage->new($o{minimax}) } : undef;
die "--minimax $o{minimax}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r) . "\n" if $o{minimax} && !$MINIMAX;
my $kv_type = $o{'kv-type'} // 'auto';
die "--kv-type: auto, f16, q8_0 or q4_0\n" unless $kv_type =~ /\A(?:auto|f16|q8_0|q4_0)\z/;
my $created = time;
my $J = JSON::PP->new->utf8->canonical;

# ---- The models. A record per model the server knows: id, path, info (model_info: kind chat / embedding, arch,
# trained context, bytes, KV bytes per position), and while loaded: m (the handle), ctx, kvt, its sequences (pool)
# and requests (queue, running), used (for least recently used). --model / --embedding-model are loaded at start
# and stay; --models-dir adds the directory's models, loaded when a request names one.
my (%M, %default);  # id -> record; kind -> the record a request without 'model' gets
my $stamp = 0;

sub model_id { basename($_[0]) =~ s/(?:-\d{5}-of-\d{5})?\.gguf\z//r }

# A record for a file (dies when it is not a model this engine runs)
sub add_model {
    my ($path, $id, %x) = @_;
    my $info = model_info($path);
    die "$path: $info->{why}\n" if $info->{kind} eq 'unsupported';
    die "$path is a draft head: --draft\n" if $info->{kind} eq 'draft';
    return $M{$id} = { id => $id, path => $path, info => $info, pool => [], queue => [], running => [], %x };
}

# --models-dir: its models (a split one by its -00001-of-N file), rescanned when listed or asked for; a file's
# model_info is kept while its size and time stay. Draft heads become candidates for the chat models of their
# architecture (the first that set_draft_model takes).
my (%scanned, %dir_drafts);
sub scan {
    my $dir = $o{'models-dir'} or return;
    opendir my $dh, $dir or return;
    my (%seen, @drafts);
    for my $f (sort readdir $dh) {
        next unless $f =~ /\.gguf\z/ && $f !~ /^mmproj/i;
        next if $f =~ /-(\d{5})-of-\d{5}\.gguf\z/ && $1 != 1;
        my $path = "$dir/$f";
        my @st = stat $path or next;
        my $c = $scanned{$path};
        my $info = $c && $c->[0] == $st[9] && $c->[1] == $st[7] ? $c->[2] : eval { model_info($path) };
        $scanned{$path} = [ $st[9], $st[7], $info ];
        next unless $info;
        if ($info->{kind} eq 'draft') { push @drafts, [ $path, $info->{arch} ]; next }
        next unless $info->{kind} eq 'chat' || $info->{kind} eq 'embedding';
        my $id = model_id($f);
        next if $M{$id} && !$M{$id}{dir};  # --model's name wins
        $seen{$id} = 1;
        my $r = $M{$id} //= { id => $id, dir => 1, pool => [], queue => [], running => [] };
        @$r{qw(path info)} = ($path, $info) unless $r->{m};
    }
    for my $id (grep { $M{$_}{dir} && !$seen{$_} && !$M{$_}{m} } keys %M) { delete $M{$id} }  # gone from the dir
    %dir_drafts = ();
    push @{ $dir_drafts{ $_->[1] } }, $_->[0] for @drafts;
}

sub mem_available {
    open my $fh, '<', '/proc/meminfo' or return;
    while (<$fh>) { return $1 * 1024 if /^MemAvailable:\s+(\d+)/ }
    return;
}

# The context and KV cache type a model gets: --ctx, else its trained context unless its KV caches (each of the
# --parallel conversations has one, model_info's estimate) would take more than --kv-budget GB: then the longest
# context, in 256-position steps, that fits (Qwen3.8-Flash / Qwen3.6-35B: 262144 positions, ~3.4 / 3.1 GB as Q8_0;
# Gemma-4 26B less: 215 KB a position before its sliding-window ring). An embedding model's input is one batch:
# at most 2048. --kv-type auto: q8_0 from 32768 positions (half the memory, and faster decoding at those depths:
# Qwen3-30B-A3B at 31k 27.9 -> 30.0 tok/s, Qwen3.6-35B at 112k 32.4 -> 35.2), f16 below that and where the model's
# cache rows do not suit q8_0 (a multiple of 256 values: not Qwen2.5-0.5B's 2 x 64)
my %kv_factor = (f16 => 1, q8_0 => 17 / 32, q4_0 => 9 / 32);
sub settings {
    my ($r) = @_;
    my $trained = $r->{info}{n_ctx_train} || 4096;
    if ($r->{info}{kind} eq 'embedding') { return ($trained < 2048 ? $trained : 2048, 'f16') }
    my $kvt_for = sub { $kv_type eq 'auto' ? ($_[0] >= 32768 ? 'q8_0' : 'f16') : $kv_type };
    return ($o{ctx}, $kvt_for->($o{ctx})) if $o{ctx};
    my $per = $r->{info}{kv_bytes_per_token} * $parallel;
    my $fit = sub { $per ? int($o{'kv-budget'} * 2**30 / ($per * $kv_factor{ $_[0] }) / 256) * 256 : $trained };
    my $ctx = $trained;
    $ctx = $fit->($kvt_for->($ctx)) if $fit->($kvt_for->($ctx)) < $ctx;
    $ctx = $fit->('f16') if $kv_type eq 'auto' && $ctx < 32768 && $fit->('f16') < $ctx;  # (f16 below 32768)
    $ctx = 256 if $ctx < 256;
    return ($ctx, $kvt_for->($ctx));
}

# What a model takes while loaded: its files (pinned) and its KV caches (estimated from model_info)
sub footprint {
    my ($r) = @_;
    my ($ctx, $kvt) = settings($r);
    return $r->{info}{bytes} + $r->{info}{kv_bytes_per_token} * $ctx * seqs($r) * $kv_factor{$kvt};
}

sub seqs { my ($r) = @_; $r->{info}{kind} eq 'chat' ? $parallel : 1 }

# A loaded model's KV caches (every sequence's)
sub kv_bytes {
    my ($r) = @_;
    return $r->{ctx} ? $r->{info}{kv_bytes_per_token} * $r->{ctx} * seqs($r) * $kv_factor{ $r->{kvt} } : 0;
}

sub idle { my ($r) = @_; !@{ $r->{queue} } && !@{ $r->{running} } && !$r->{busy} }

sub unload {
    my ($r) = @_;
    return unless $r->{m};
    @$r{qw(pool queue running)} = ([], [], []);
    delete $default{ $r->{info}{kind} } if ($default{ $r->{info}{kind} } // 0) == $r && $r->{dir};
    undef $r->{m};  # (the only reference: unmapped and unpinned now)
    delete $r->{vision};
    $LOG->info('model', model => $r->{id}, event => 'unload', msg => 'unloaded');
}

# Before loading r: unload idle models (least recently used first, never --model / --embedding-model) until r fits
# in the memory available less --models-margin GB, and --models-max allows one more. Loaded anyway when nothing more
# can go. Available: MemAvailable (what other programs hold, llama-server's too, is not in it) less the files of the
# models loaded here: their pages are pinned, but the kernel still counts them as page cache it could reclaim
# (Qwen3.6-35B, 20 GB pinned: MemAvailable 2.7 GB lower, its KV cache and scratch).
sub make_room {
    my ($r) = @_;
    my $need = footprint($r);
    my @lru = sort { $a->{used} <=> $b->{used} } grep { $_->{m} && $_->{dir} && $_ != $r } values %M;
    while (1) {
        my $avail = mem_available();
        if (defined $avail) { $avail -= $_->{info}{bytes} for grep { $_->{m} } values %M }
        my $fits = !defined $avail || $avail - $o{'models-margin'} * 2**30 >= $need;
        my $count_ok = !$o{'models-max'} || (grep { $_->{m} } values %M) < $o{'models-max'};
        last if $fits && $count_ok;
        my ($victim) = grep { idle($_) } @lru or last;
        @lru = grep { $_ != $victim } @lru;
        unload($victim);
    }
}

sub load {
    my ($r) = @_;
    return $r if $r->{m};
    make_room($r);
    my ($ctx, $kvt) = settings($r);
    # --recache: drop the model file's cached pages first, so that it is read again as 2 MB pages (the GPU reads the
    # weights in place: fewer TLB misses; it pays where the page cache holds the file in 4 KB pages)
    local $ENV{GGUF_RECACHE} = $o{recache} ? 1 : $ENV{GGUF_RECACHE};
    delete $ENV{GGUF_RECACHE} unless defined $ENV{GGUF_RECACHE};
    my $t_load = Time::HiRes::time();
    my $m = eval { load_model($r->{path}, { stage => $o{stage} }) };
    $m or die "cannot load $r->{path}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r || last_error()) . "\n";
    my $pages = stage_info($m);
    my $mem = $pages =~ /(\d+) of (\d+) MB on 2 MB pages/ ? "$1 of $2 MB on 2 MB pages" : '';
    $r->{resident} = $pages =~ /(\d+) of (\d+) MB/ ? $2 * 2**20 : undef;  # (what is pinned: resident)
    my $emb = $r->{info}{kind} eq 'embedding';
    # a block store needs every layer's history: no sliding-window ring unless asked for
    set_swa_ring($m, $o{'swa-ring'} // ($o{store} ? 0 : -1)) unless $emb;
    set_kv_type($m, $kvt);
    if (!eval { kv_cache_init($m, $ctx); 1 }) {
        die $@ unless $kv_type eq 'auto' && $kvt eq 'q8_0';
        set_kv_type($m, $kvt = 'f16');
        kv_cache_init($m, $ctx);
    }
    $LOG->info('model', model => $r->{id}, event => 'load', msg => sprintf('%s: context %d (trained %d), KV cache %s, %.1f s%s',
        $r->{path}, $ctx, $r->{info}{n_ctx_train}, $kvt, Time::HiRes::time() - $t_load, $mem ? ", model memory $mem" : ''));
    set_event_handler($m, sub { on_event($r, @_) });
    if (!$emb) {
        if ($r->{draft}) {
            set_draft_model($m, $r->{draft});
        } elsif (!$no_draft && $parallel == 1) {
            # the model's own MTP block (Qwen3.8-Flash-Next from the BF16: nothing more to load), else a draft head
            # of the directory that fits this model
            for my $d ($r->{path}, $r->{dir} ? @{ $dir_drafts{ $r->{info}{arch} } // [] } : ()) {
                next unless eval { set_draft_model($m, $d); 1 };
                $LOG->info('model', model => $r->{id}, event => 'draft',
                           msg => $d eq $r->{path} ? 'draft head: the model\'s own MTP block' : "draft head $d");
                last;
            }
        }
        die "--store needs every layer's KV history: --swa-ring 0 (the default with --store)\n"
            if $o{store} && swa_ring($m);
        if ($o{store}) {
            store_open($m, $o{store}, $o{'store-snapshot-every'} // 4);
            store_set_lazy($m, $o{'store-snapshots'} eq 'lazy' ? 1 : 0);
            my ($bytes, $files) = store_usage($o{store});
            $LOG->info('store', model => $r->{id}, event => 'open',
                       msg => sprintf('KV store %s: %d files, %.2f GB, %d tokens a block; snapshots %s, every %d blocks',
                                      $o{store}, $files, $bytes / 2**30, store_stats($m)->{block_tokens},
                                      $o{'store-snapshots'}, $o{'store-snapshot-every'} // 4));
            # (a store on a disk: the KV cache stays in /dev/shm, a block is published as a copy, not a link)
            $LOG->warn_(model => $r->{id}, event => 'open',
                        msg => "KV store $o{store} is not in memory (not tmpfs): the KV cache stays in /dev/shm and "
                             . 'each block is copied to the store (a disk write per block, slower than on tmpfs)')
                if store_stats($m)->{on_disk};
        }
    }
    # --parallel N: N sequences (conversations at once), each a KV cache of the context; sequence 0 and N - 1 more
    $r->{pool} = [ map { { seq => $_, job => undef, prompt => [] } } 0, $emb ? () : map { seq_new($m) } 2 .. $parallel ];
    if ($o{mmproj} && !$emb) {
        # --mmproj: the vision tower (images in chat requests); its output must be the model's width
        my $v = eval { vision_load($o{mmproj}) };
        if (!$v) {
            $LOG->warn_(model => $r->{id}, event => 'load', msg => "--mmproj $o{mmproj}: " . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r));
        } elsif ($v->n_out != hidden_size($m)) {
            $LOG->warn_(model => $r->{id}, event => 'load',
                        msg => sprintf('--mmproj %s: its output is %d wide, the model %d: no images for this model',
                                       $o{mmproj}, $v->n_out, hidden_size($m)));
        } else {
            $r->{vision} = $v;
            $LOG->info('model', model => $r->{id}, event => 'vision', msg => "vision tower $o{mmproj}");
        }
    }
    @$r{qw(m ctx kvt)} = ($m, $ctx, $kvt);
    memory_check($r, $m);
    return $r;
}

sub mem_total {
    open my $fh, '<', '/proc/meminfo' or return;
    while (<$fh>) { return $1 * 1024 if /^MemTotal:\s+(\d+)/ }
    return;
}

# After a load: a warning when the loaded models do not fit the RAM. What the GPU reads is held in memory (pinned:
# the size stage_info reports at the load); what only the CPU reads (the token embeddings, Qwen3.8-Flash's 35.8 GiB
# PLE table) stays in the file and is read through the page cache, so it is fast only while the page cache can keep
# it: else a prefill reads its rows from the disk (the GPU idle, waiting for them). Counted against the RAM: each
# loaded model's resident part and KV caches, and a block store in memory (tmpfs: --store-max, or its size without
# a cap), which nothing evicts without swap; what is left is the page cache for the CPU-read parts
sub memory_check {
    my ($r, $m) = @_;
    my $total = mem_total() or return;
    my @loaded = grep { $_->{m} } values %M;
    my ($held, $cpu) = (0, 0);
    for my $x (@loaded) {
        my $res = $x->{resident} // $x->{info}{bytes};
        $held += $res + kv_bytes($x);
        $cpu += $x->{info}{bytes} - $res if $x->{info}{bytes} > $res;
    }
    my $store = 0;
    if ($o{store} && !store_stats($m)->{on_disk}) {
        my ($bytes) = store_usage($o{store});
        $store = $o{'store-max'} > 0 ? $o{'store-max'} * 2**30 : $bytes // 0;
    }
    my $need = $held + $store;
    return if $need + $cpu <= $total;
    my $gb = sub { sprintf '%.1f', $_[0] / 2**30 };
    my $what = sprintf('%d loaded model%s: %s GB in memory with their KV caches (this one %s GB + %s GB KV for %d x %d '
                     . 'positions)%s', scalar @loaded, @loaded == 1 ? '' : 's', $gb->($held),
                       $gb->($r->{resident} // $r->{info}{bytes}), $gb->(kv_bytes($r)), seqs($r), $r->{ctx},
                       $store ? ', the KV store in memory ' . $gb->($store) . ' GB' : '');
    my $fix = 'a smaller --ctx or --parallel' . ($store ? ', the store on a disk or a smaller --store-max' : '')
            . ', or fewer models loaded';
    if ($need > $total) {
        $LOG->warn_(model => $r->{id}, event => 'memory',
                    msg => sprintf('%s GB of RAM, %s: %s GB more than there is. Memory runs out (the kernel reclaims '
                                 . 'what it can, a prefill can stall): %s', $gb->($total), $what, $gb->($need - $total), $fix));
    } else {
        $LOG->warn_(model => $r->{id}, event => 'memory',
                    msg => sprintf('%s GB of RAM, %s: %s GB left for the page cache, which the %s GB the CPU reads from '
                                 . 'the model files (token embeddings, PLE tables) do not fit. A prefill then reads '
                                 . 'those rows from the disk (slow, the GPU idle): %s', $gb->($total), $what,
                                   $gb->($total - $need), $gb->($cpu), $fix));
    }
}

# An OpenAI-style error, as a response to die with
sub error {
    my ($status, $msg, $type) = @_;
    die json({ error => { message => $msg, type => $type // 'invalid_request_error' } }, $status);
}

# The model a request is for (loaded): its 'model' if the server knows it, else the default of the kind. With
# --models-dir an unknown name is an error; with --model alone any name gets the model, as before.
sub pick {
    my ($p, $kind) = @_;
    scan();
    my $want = ref $p eq 'HASH' && defined $p->{model} && !ref $p->{model} && length $p->{model} ? $p->{model} : undef;
    my $r = defined $want ? $M{$want} : undef;
    if (!$r) {
        error(404, "model '$want' not found (GET /v1/models lists them)", 'not_found_error')
            if defined $want && $o{'models-dir'};
        $r = $default{$kind};
        my @k = grep { $_->{info}{kind} eq $kind } values %M;
        $r //= $k[0] if @k == 1;
        $r or error(400, $kind eq 'embedding' && !@k ? 'no embedding model (--embedding-model, or one in --models-dir)'
                                                     : "say which model ('model'): GET /v1/models lists them");
    }
    if ($r->{info}{kind} ne $kind) {
        error(400, "$r->{id} is an embedding model: use /v1/embeddings") if $kind eq 'chat';
        error(400, "$r->{id} is not an embedding model (start the server with --embedding-model)");
    }
    if (!eval { load($r); 1 }) {
        my $why = $@ =~ s/\n\z//r;
        $LOG->error(model => $r->{id}, event => 'load', msg => "failed: $why");  # the server log keeps it too
        error(500, $why, 'server_error');
    }
    $r->{used} = ++$stamp;
    $default{$kind} = $r if $r->{dir} || !$default{$kind};  # (the last used, for requests that name none)
    return $r;
}

if ($o{model}) {
    my $r = eval { add_model($o{model}, $o{name} // model_id($o{model}), draft => $o{draft}) } or die $@;
    die "--store, --draft, --parallel: not for an embedding model\n"
        if $r->{info}{kind} eq 'embedding' && ($o{store} || $o{draft} || $parallel > 1);
    load($r);
    $r->{used} = ++$stamp;
    $default{ $r->{info}{kind} } = $r;
}
if ($o{'embedding-model'}) {
    die "--embedding-model: --model is an embedding model already\n" if $default{embedding};
    my $r = add_model($o{'embedding-model'}, $o{'embedding-name'} // model_id($o{'embedding-model'}));
    die "$o{'embedding-model'} is not an embedding model\n" unless $r->{info}{kind} eq 'embedding';
    load($r);
    $r->{used} = ++$stamp;
    $default{embedding} = $r;
}
scan();

sub model_entry {
    my ($r) = @_;
    my ($ctx) = $r->{m} ? $r->{ctx} : settings($r);
    return { id => $r->{id}, object => 'model', created => $created, owned_by => 'rocm-inference',
             status => { value => $r->{m} ? 'loaded' : 'unloaded' }, kind => $r->{info}{kind}, arch => $r->{info}{arch},
             context_length => $ctx, n_ctx_train => $r->{info}{n_ctx_train}, bytes => $r->{info}{bytes} };
}

route::get '/health' => sub { { status => 'ok' } };

route::get '/v1/models' => sub {
    scan();
    { object => 'list', data => [ map { model_entry($M{$_}) } sort keys %M ] };
};
route::get '/v1/models/*id' => sub {
    my ($req) = @_;
    scan();
    my $r = $M{ $req->{params}{id} } or error(404, "no model '$req->{params}{id}'", 'not_found_error');
    model_entry($r);
};

# llama.cpp's router: load a model now, or unload one that serves no request ({"model": id})
route::post '/models/load' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' && defined $p->{model} or error(400, "expected {\"model\": id}");
    scan();
    my $r = $M{ $p->{model} } or error(404, "no model '$p->{model}'", 'not_found_error');
    pick($p, $r->{info}{kind});
    { success => JSON::PP::true, model => model_entry($r) };
};
route::post '/models/unload' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' && defined $p->{model} or error(400, "expected {\"model\": id}");
    my $r = $M{ $p->{model} } or error(404, "no model '$p->{model}'", 'not_found_error');
    idle($r) or error(409, "$r->{id} is serving requests");
    unload($r);
    { success => JSON::PP::true, model => model_entry($r) };
};

# An image part's bytes: a data: URL (base64) in the request; the server does not fetch URLs
sub image_bytes {
    my ($part) = @_;
    my $url = ref $part->{image_url} eq 'HASH' ? $part->{image_url}{url} : $part->{image_url};
    error(400, 'image_url: a data: URL (data:image/...;base64,...) is needed; the server does not fetch URLs')
        unless defined $url && !ref $url && $url =~ m{\Adata:image/[^;,]+;base64,(.*)\z}s;
    my $bytes = decode_base64($1);
    error(400, 'image_url: empty image') unless length $bytes;
    return $bytes;
}

# OpenAI messages as the chat template wants them: text parts joined, tool call arguments as hashes,
# 'developer' as 'system'. An image part (image_url) becomes an image placeholder in its message's content, and its
# bytes go to $images in order (the chat's images); a message with none keeps its text as one string.
sub messages {
    my ($in, $images) = @_;
    ref $in eq 'ARRAY' && @$in or error(400, "'messages' must be a non-empty array");
    my @out;
    for my $msg (@$in) {
        ref $msg eq 'HASH' && defined $msg->{role} or error(400, 'each message needs a role');
        my %m = %$msg;
        $m{role} = 'system' if $m{role} eq 'developer';
        if (ref $m{content} eq 'ARRAY') {
            for (@{ $m{content} }) {
                my $t = $_->{type} // '';
                error(400, "content parts of type '$t' are not supported") unless $t eq 'text' || $t eq 'image_url';
            }
            if (grep { $_->{type} eq 'image_url' } @{ $m{content} }) {
                error(400, 'images: the server needs --mmproj (the vision tower of the model)') unless $images;
                $m{content} = [ map {
                    if ($_->{type} eq 'image_url') { push @$images, image_bytes($_); { type => 'image' } }
                    else { { type => 'text', text => $_->{text} // '' } }
                } @{ $m{content} } ];
            } else {
                $m{content} = join '', map { $_->{text} // '' } @{ $m{content} };
            }
        }
        $m{content} //= '';
        if (ref $m{tool_calls} eq 'ARRAY') {
            $m{tool_calls} = [ map {
                my %c = %$_;
                my %f = %{ $c{function} // {} };
                $f{arguments} = eval { $J->decode($f{arguments}) } // $f{arguments} if defined $f{arguments} && !ref $f{arguments};
                $c{function} = \%f;
                \%c;
            } @{ $m{tool_calls} } ];
        }
        push @out, \%m;
    }
    return \@out;
}

# The request's options as chat's
sub options {
    my ($p, $r) = @_;
    error(400, 'n > 1 is not supported') if ($p->{n} // 1) != 1;
    my %vars = %{ ref $p->{chat_template_kwargs} eq 'HASH' ? $p->{chat_template_kwargs} : {} };
    $vars{tools} = $p->{tools} if ref $p->{tools} eq 'ARRAY' && @{ $p->{tools} } && ($p->{tool_choice} // '') ne 'none';
    if (!exists $vars{enable_thinking}) {
        my $effort = $p->{reasoning_effort};
        $vars{enable_thinking} = defined $effort ? ($effort =~ /^(?:none|minimal)\z/ ? 0 : 1) : $o{thinking}
            if defined $effort || defined $o{thinking};
    }
    # Qwen3.6's template drops the reasoning of the assistant messages before the last user message: a new user message
    # re-renders the whole previous turn (its tool calls and results), and its tokens are prefilled again. With
    # preserve_thinking the history renders the same every time (templates without the variable ignore it)
    $vars{preserve_thinking} = JSON::PP::true() if !exists $vars{preserve_thinking} && ($o{'preserve-thinking'} // 1);
    # the request's max_tokens, else up to the context's end (finish_reason length); --max_tokens N caps both
    my $want = $p->{max_completion_tokens} // $p->{max_tokens};
    $want = $r->{ctx} if !defined $want || $want < 1;
    $want = $o{max_tokens} if $o{max_tokens} > 0 && $want > $o{max_tokens};
    my %c = (vars => \%vars, max_new_tokens => $want);
    for (qw(temperature top_p top_k min_p seed repeat_penalty presence_penalty repeat_last_n)) { $c{$_} = $p->{$_} if defined $p->{$_} }
    $c{stop} = ref $p->{stop} ? $p->{stop} : [ $p->{stop} ] if defined $p->{stop};
    my $budget = $p->{max_thinking_tokens} // $p->{thinking_budget_tokens};
    # with no budget of its own, reasoning_effort gives one: low, medium, high (none and minimal turned thinking off above)
    if (!defined $budget && defined $p->{reasoning_effort} && ($vars{enable_thinking} // 1)) {
        my $e = $p->{reasoning_effort};
        $budget = $e eq 'low' ? $o{'thinking-low'} : $e eq 'medium' ? $o{'thinking-medium'} : $o{'thinking-high'};
        $budget = undef unless $budget > 0;
    }
    $c{max_thinking_tokens} = $budget if defined $budget && $budget >= 0;
    return \%c;
}

# A tool call as it is written, streamed as OpenAI streams one (delta.tool_calls): the function's name when its tag
# closes, then the arguments as JSON pieces, one per parameter as each one closes. The text is the one the parser reads
# (<function=NAME> <parameter=KEY>VALUE</parameter>), so the pieces are the arguments of the final message. A second call
# in the reply is not streamed: the server sends it whole at the end (tool_stream_end's caller).
sub tool_stream_new {
    return { buf => '', pos => 0, name => undef, n => 0, bytes => 0, first_end => 0, cut => -1,
             id => sprintf('call_%08x%08x', int rand 2**32, int rand 2**32) };
}

sub tool_stream_feed {
    my ($st, $text) = @_;
    $st->{buf} .= $text;
    my @d;
    if (!defined $st->{name} && $st->{buf} =~ /<function=([^>\n]+)>/) {
        $st->{name} = $1;
        $st->{first_end} = $+[0];
        push @d, { index => 0, id => $st->{id}, type => 'function', function => { name => $1, arguments => '{' } };
    }
    return @d unless defined $st->{name};
    if ($st->{cut} < 0) {  # the first call ends where the second one's tag starts
        my $c = index($st->{buf}, '<function=', $st->{first_end});
        $st->{cut} = $c if $c >= 0;
    }
    my $stop = $st->{cut} >= 0 ? $st->{cut} : length $st->{buf};
    my $rest = substr($st->{buf}, $st->{pos}, $stop - $st->{pos});
    my $end = 0;
    while ($rest =~ /<parameter=([^>\n]+)>\n?(.*?)\n?<\/parameter>/sg) {
        my ($k, $v) = ($1, $2);
        $end = pos($rest);
        my $frag = ($st->{n}++ ? ',' : '') . $J->encode($k) . ':' . $J->encode($v);
        $st->{bytes} += length $frag;
        push @d, { index => 0, function => { arguments => $frag } };
    }
    $st->{pos} += $end;
    return @d;
}

# the closing piece of a streamed call
sub tool_stream_end { return { index => 0, function => { arguments => '}' } } }

sub tool_calls {
    my ($msg) = @_;
    return [ map { {
        id       => sprintf('call_%08x%08x', int rand 2**32, int rand 2**32),
        type     => 'function',
        function => { name => $_->{function}{name}, arguments => ref $_->{function}{arguments}
                          ? $J->encode($_->{function}{arguments}) : $_->{function}{arguments} // '{}' },
    } } @{ $msg->{tool_calls} // [] } ];
}

sub finish_reason {
    my ($why, $msg) = @_;
    return 'tool_calls' if $msg->{tool_calls};
    return $why == STOP_MAX_TOKENS() || $why == STOP_CONTEXT_FULL() ? 'length' : 'stop';
}

# OpenAI's /v1/embeddings: input a string, an array of strings, an array of token ids or an array of those;
# encoding_format float (default) or base64 (little-endian float32); dimensions: the first N values, renormalized
# (EmbeddingGemma is trained for 768, 512, 256 and 128). Each input is one batch: at most the context's tokens.
sub is_number { my $f = B::svref_2object(\$_[0])->FLAGS; !ref $_[0] && ($f & (B::SVp_IOK | B::SVp_NOK)) && !($f & B::SVp_POK) }
route::post '/v1/embeddings' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' or error(400, 'expected a JSON object (Content-Type: application/json)');
    my $r = pick($p, 'embedding');
    my $E = $r->{m};
    my $in = $p->{input};
    my @inputs = !ref $in                                        ? ($in)
               : ref $in eq 'ARRAY' && @$in && is_number($in->[0]) ? ($in)
               : ref $in eq 'ARRAY'                              ? @$in
               :                                                   ();
    @inputs && !grep { !defined || (ref && ref ne 'ARRAY') } @inputs
        or error(400, "'input' must be a string, an array of strings or of token arrays");
    my $fmt = $p->{encoding_format} // 'float';
    $fmt =~ /^(?:float|base64)\z/ or error(400, "encoding_format: float or base64");
    my $dim = embedding_dim($E);
    my $want = $p->{dimensions} // $dim;
    $want =~ /^\d+\z/ && $want >= 1 && $want <= $dim or error(400, "dimensions: 1 .. $dim");
    my $ctx = n_ctx($E);
    my ($i, $tokens, @data) = (0, 0);
    for my $x (@inputs) {
        my $ids = ref $x ? [ map { int } @$x ] : tokenize($E, $x);
        @$ids <= $ctx or error(400, "input $i is " . @$ids . " tokens, more than the context ($ctx)");
        @$ids or error(400, "input $i is empty");
        my $e = eval { embed($E, $ids, 1) } or error(500, $@ =~ s/ at \S+ line \d+\.?\n?\z//r, 'server_error');
        if ($want < $dim) {  # Matryoshka: the leading values, back to length 1
            $e = [ @$e[ 0 .. $want - 1 ] ];
            my $n = 0;
            $n += $_ * $_ for @$e;
            $n = sqrt $n || 1;
            $_ /= $n for @$e;
        }
        push @data, { object => 'embedding', index => $i++,
                      embedding => $fmt eq 'base64' ? encode_base64(pack('f<*', @$e), '') : $e };
        $tokens += @$ids;
    }
    { object => 'list', data => \@data, model => $r->{id}, usage => { prompt_tokens => $tokens, total_tokens => $tokens } };
};

# The request's record, carried through its lifecycle: id, client, user (nginx's X-Remote-User), conversation (the
# X-LLamaCPP-Id-slot header of the opencode fixups), model, start time
sub request_ctx {
    my ($req, $r) = @_;
    my %h = %{ $req->{headers} // {} };
    # the store's counters when the request starts: its own mapped and published blocks are the difference at the end
    my $q = { req => sprintf('chatcmpl-%x%06x', time, int rand 2**24), ip => $req->{remote}, user => $h{'x-remote-user'},
              conv => $h{'x-llamacpp-id-slot'}, model => $r->{id}, t0 => Time::HiRes::time(), m => $r->{m} };
    $q->{st0} = store_stats($r->{m}) if $o{store} && $r->{m};
    # when the server read the request (Web::Route: after the requests before it, so a busy server shows here), and how
    # long it waited before that: now less the time nginx sent it (X-Request-Start: nginx's $msec, when the route sets it)
    $q->{accepted} = $req->{accepted};
    $q->{client_gone} = $req->{client_gone};  # (Web::Route: true once the client has closed its end)
    if (my ($sent) = ($h{'x-request-start'} // '') =~ /(\d+(?:\.\d+)?)\s*\z/) {
        $q->{wait_ms} = 1000 * ($req->{accepted} - $sent) if $req->{accepted};
    }
    return $q;
}

sub log_fields { my ($q) = @_; return map { ($_ => $q->{$_}) } qw(user ip conv req model) }

# a line when a chat request begins
sub start_line {
    my ($q, $p, $opts) = @_;
    $LOG->info('request', log_fields($q), event => 'start',
               msg => sprintf('stream=%d max_tokens=%s reasoning_effort=%s thinking_budget=%s waited %s ms', $p->{stream} ? 1 : 0,
                              $p->{max_completion_tokens} // $p->{max_tokens} // 'default',
                              $p->{reasoning_effort} // '-', $opts->{max_thinking_tokens} // '-',
                              defined $q->{wait_ms} ? sprintf('%.0f', $q->{wait_ms}) : '-'));
}

# a line when a chat request is done: its prompt (reused from the cache / prefilled now), pp/s (the prefill's rate),
# tg/s over the whole reply and, when the reply has a thinking section, for the thinking and for the answer
sub done_line {
    my ($q, $usage, $prefill, $finish) = @_;
    my $now = Time::HiRes::time();
    my $secs = $now - $q->{t0};
    my ($reused, $prefilled) = $prefill ? @$prefill : ('-', '-');
    my $out = $usage->{completion_tokens};
    my $rate = sub { my ($n, $t) = @_; $n > 1 && $t > 0 ? sprintf('%.1f', $n / $t) : '-' };
    my $pp = $q->{prefill_ms} && $q->{prefill_n} ? sprintf('%.1f', $q->{prefill_n} / ($q->{prefill_ms} / 1000)) : '-';
    my $tg = $q->{first_at} ? $rate->($out, $now - $q->{first_at}) : '-';
    my $split = '';
    if ($q->{think_end} && $q->{first_at}) {
        my $th = $q->{think_tok} // 0;
        $split = sprintf(' (thinking %s, answer %s tg/s)', $rate->($th, $q->{think_end} - $q->{first_at}),
                         $rate->($out - $th, $now - $q->{think_end}));
    }
    my $queued = defined $q->{queued_ms} ? sprintf(', queued %.0f ms', $q->{queued_ms}) : '';
    $LOG->info('generation', log_fields($q), event => 'done',
               msg => sprintf('%s: prompt %d tok (reused %s, prefilled %s), pp %s tok/s; %d tok out in %.2f s, tg %s tok/s%s; first token %s ms%s',
                              $finish, $usage->{prompt_tokens}, $reused, $prefilled, $pp, $out, $secs, $tg, $split,
                              defined $q->{ttft} ? sprintf('%.0f', $q->{ttft}) : '-', $queued));
    store_report($q);
    store_trim();
}

# What the request's KV cache took from the store: the blocks mapped in (the prompt's first ones, read in place, no
# copy), the blocks it wrote, and the store's size. Blocks already in its sequence are not mapped again.
sub store_report {
    my ($q) = @_;
    return unless $o{store} && $q->{st0} && $q->{m};
    my $st = eval { store_stats($q->{m}) } or return;
    my ($bb, $tb) = @$st{qw(block_bytes block_tokens)};
    my %d = map { $_ => $st->{$_} - $q->{st0}{$_} } qw(blocks_attached blocks_published tokens_from_store);
    my $tok = max(0, $d{tokens_from_store}) - max(0, $d{tokens_from_store}) % $tb;
    my ($bytes, $files) = eval { store_usage($o{store}) };
    $LOG->info('store', log_fields($q), event => 'kv',
               msg => sprintf('mapped %d blocks (tok 0-%d, %.1f MB) from %s, published %d (%.1f MB); store %d files, %.2f GB of %.0f GB',
                              $d{blocks_attached}, $tok, $d{blocks_attached} * $bb / 2**20, $o{store}, $d{blocks_published},
                              $d{blocks_published} * $bb / 2**20, $files // 0, ($bytes // 0) / 2**30, $o{'store-max'}));
}

# The KV store is trimmed to --store-max GB after each request: the least recently used files go first (a block in
# use was touched by its last request, so it goes last). A file a sequence maps stays readable until it is unmapped.
sub store_trim {
    return unless $o{store} && $o{'store-max'} > 0;
    my @gone = eval { store_evict($o{store}, max_bytes => $o{'store-max'} * 2**30) };
    if ($@) { $LOG->warn_(event => 'store', msg => "trim failed: " . ($@ =~ s/\s+\z//r)); return }
    return unless @gone;
    my $now = eval { store_usage($o{store}) } // 0;
    $LOG->info('store', event => 'evict', msg => sprintf('evicted %d files; store now %.2f GB of %.1f GB',
                                                     scalar @gone, $now / 2**30, $o{'store-max'}));
}

# The engine's events for a model (set_event_handler at load): the request in progress on it ($r->{cur}) labels them;
# with --parallel, the job on the event's sequence
sub on_event {
    my ($r, $ev, $info) = @_;
    my $q = $r->{cur};
    if (!$q && defined $info->{seq}) {
        my ($slot) = grep { $_->{job} && $_->{seq} == $info->{seq} } @{ $r->{pool} // [] };
        $q = $slot->{job}{q} if $slot;
    }
    $q //= {};
    my %f = (model => $r->{id}, event => $ev, map { ($_ => $q->{$_}) } qw(user ip conv req));
    my ($n0, $n1, $ms) = @$info{qw(n0 n1 ms)};
    # (a --parallel job's prompt goes in by chunks between the other jobs' tokens: the engine reports them as one
    # prefill, its progress over the whole prompt)
    if ($ev eq 'prefill_progress') {
        $q->{prefill_at} = $n0;  # (where a cancel finds it)
        $LOG->progress($q->{req} // $r->{id}, $n0, $n1, %f);
        # the client is asked whether it is still there: an SSE comment (clients ignore it) also keeps a proxy from timing
        # out. A failed write means it has gone: the prefill is cancelled (a true return from here). A plain JSON reply
        # has nothing to write: the socket tells (client_gone; nginx closes its upstream when its client leaves)
        # (a --parallel job: Web::Route's on_close cancels it, between its chunks)
        my $w = $q->{write};
        my $gone = $w ? !$w->(sprintf(": prefill %d%%\n\n", $n1 ? 100 * $n0 / $n1 : 100))
                      : !$q->{chunked} && $q->{client_gone} && $q->{client_gone}->();
        if ($gone) {
            $LOG->warn_(%f, msg => sprintf('client gone during the prefill, after %d of %d tok: cancelled', $n0, $n1));
            $LOG->progress_end($q->{req}) if $q->{req};
            $q->{gone} = 1;
            return 1;
        }
    } elsif ($ev eq 'prefill_end') {
        # the prompt's (a thinking budget's close is a second, small prefill: not this one)
        @$q{qw(prefill_n prefill_ms)} = ($n0, $ms) unless $q->{prefill_logged};
        prefill_done_line($q, %f, blocks => $n1);
    } elsif ($ev eq 'prefill_begin') {
        $LOG->debug('prefill', %f, msg => "prefill of $n0 tok");
    } elsif ($ev eq 'draft') {
        $LOG->debug('generation', %f, msg => sprintf('draft: %d proposed, %d accepted, pass %.1f ms', $n0, $n1, $ms));
    } elsif ($ev eq 'context_full') {
        $LOG->warn_(%f, msg => "context full at $n0 tokens");
    } else {
        $LOG->debug('store', %f, msg => "$ev: $n0, $n1");
    }
    return 0;  # only a prefill_progress return of true cancels (the loggers' return values are not that)
}

# The prefill's line, once the request's prompt is in
sub prefill_done_line {
    my ($q, %f) = @_;
    return if $q->{prefill_logged}++;
    $LOG->progress_end($q->{req}) if $q->{req};
    my $blocks = delete $f{blocks} // 0;
    my ($n, $ms) = ($q->{prefill_n} // 0, $q->{prefill_ms} // 0);
    my $rate = $ms > 0 ? sprintf('%.0f', 1000 * $n / $ms) : '-';
    $LOG->info('prefill', %f, event => 'prefill_end',
               msg => sprintf('prefill done: %d tok in %.2f s (%s tok/s), %d store blocks', $n, $ms / 1000, $rate, $blocks));
}

# A line every 5 s while a reply runs: the phase (thinking, answer or a tool call), its tokens and its rate. $n: the
# reply's tokens so far
sub gen_progress {
    my ($q, $n, $now) = @_;
    return unless $q->{first_at} && $now - ($q->{gen_log_t} // $q->{first_at}) >= 5;
    $q->{gen_log_t} = $now;
    my $rate = sub { my ($k, $t) = @_; $k > 0 && $t > 0 ? sprintf('%.1f', $k / $t) : '-' };
    my $msg;
    if (($q->{kind} // '') eq 'tool_call') {
        my $ts = $q->{ts} // {};
        $msg = sprintf('tool call %s: %d params done, %d B of arguments, %d tok in the reply, %s tg/s',
                       $ts->{name} // '?', $ts->{n} // 0, $ts->{bytes} // 0, $n, $rate->($n, $now - $q->{first_at}));
    } elsif (defined $q->{think_end}) {
        my $ans = $n - ($q->{think_tok} // 0);
        $msg = sprintf('answer %d tok, %s tg/s (thinking %d tok)', $ans, $rate->($ans, $now - $q->{think_end}),
                       $q->{think_tok} // 0);
    } else {
        $msg = sprintf('%s %d tok, %s tg/s', ($q->{kind} // 'reasoning') eq 'reasoning' ? 'thinking' : 'answer', $n,
                       $rate->($n, $now - $q->{first_at}));
    }
    $LOG->info('generation', log_fields($q), event => 'generating', msg => $msg);
}

# --debug-stream: what goes to the client, a line per piece
sub debug_stream {
    my ($q, $kind, $piece) = @_;
    $LOG->info('stream', log_fields($q), event => $kind eq 'tool_call' ? 'tool' : $kind, msg => $J->encode($piece))
        if $o{'debug-stream'};
}

# The access line of a request (Web::Route's log): the same formatter as the rest
sub access_line {
    my ($req, $status, $ms) = @_;
    $req //= {};
    my %h = %{ $req->{headers} // {} };
    $LOG->info('request', user => $h{'x-remote-user'}, ip => $req->{remote}, event => 'access',
               msg => sprintf('%s %s %d %.0f ms', $req->{method} // '-', $req->{path} // '-', $status, $ms));
}

# OpenAI's transcription: a multipart/form-data body with the audio file (a WAV: PCM 8 to 32 bits or float, any length),
# optional language (a code, default en) and response_format (json, the default, or text). 'model' is accepted and
# ignored: a server has one speech model (--whisper)
route::post '/v1/audio/transcriptions' => sub {
    my ($req) = @_;
    my $ct = $req->{headers}{'content-type'} // '';
    error(400, 'expected multipart/form-data with the audio file in the part "file"') unless $ct =~ m{multipart/form-data}i;
    error(503, 'no speech model: start the server with --whisper FILE.gguf', 'server_error') unless $WHISPER;
    my $parts = eval { ROCm::Inference::Multipart::parse($req->{body}, $ct) }
        or error(400, 'bad multipart body: ' . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r));
    my $file = $parts->{file} or error(400, "'file' is required (a WAV file)");
    my $field = sub { my $p = $parts->{$_[0]} or return undef; (my $v = $p->{data}) =~ s/\A\s+|\s+\z//g; $v };
    my $lang = $field->('language') // 'en';
    error(400, "language: a code such as en, not '$lang'") unless $lang =~ /\A[a-z]{2,3}\z/;
    my $fmt = $field->('response_format') // 'json';
    error(400, "response_format: json or text, not '$fmt'") unless $fmt =~ /\A(?:json|text)\z/;
    my $task = $field->('task') // 'transcribe';
    error(400, "task: transcribe or translate, not '$task'") unless $task =~ /\A(?:transcribe|translate)\z/;
    my ($text) = eval { $WHISPER->transcribe($file->{data}, language => $lang, task => $task) };
    error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) if $@;
    $text =~ s/\A\s+|\s+\z//g;
    $LOG->info('request', event => 'transcription', msg => sprintf('%s: %d bytes, language %s, task %s, %d chars of text',
                                                               $whisper_name, length $file->{data}, $lang, $task, length $text));
    return text($text) if $fmt eq 'text';
    return { text => $text };
};

# OpenAI's speech: a JSON body with the input text, the voice (a directory under --voices), the language (a name such as
# english, default english), response_format (wav, the only one) and the sampling: temperature, top_k, repetition_penalty,
# seed (0 by default: the same request, the same speech), max_frames (the talker's bound). 'model' is ignored. The
# speech is generated on the host, one request at a time (the request waits for it).
route::post '/v1/audio/speech' => sub {
    my ($req) = @_;
    error(503, 'no speech model: start the server with --tts TALKER.gguf --tts-codec CODEC.gguf --voices DIR', 'server_error')
        unless $TTS;
    my $p = $req->{json};
    ref $p eq 'HASH' or error(400, 'expected a JSON object (Content-Type: application/json)');
    my $input = $p->{input};
    error(400, "'input' is required (the text to say)") unless defined $input && !ref $input && length $input;
    error(400, 'input: at most 4096 characters') if length $input > 4096;
    my $voice = $p->{voice} // '';
    error(400, "'voice' is required: a voice directory's name") unless $voice =~ /\A[A-Za-z0-9_.-]+\z/ && $voice !~ /\A\.{1,2}\z/;
    error(503, 'no voices: start the server with --voices DIR') unless $o{voices};
    my $v = eval { ROCm::Inference::speech_voice("$o{voices}/$voice") } or error(404, "no voice '$voice' in --voices");
    my $fmt = $p->{response_format} // 'wav';
    error(400, "response_format: wav, not '$fmt'") unless $fmt eq 'wav';
    my $lang = $p->{language} // 'english';
    error(400, "language: a name such as english, not '$lang'") unless $lang =~ /\A[a-z]{3,20}\z/;
    my %smp;
    for my $k (qw(temperature repetition_penalty sub_temperature)) {
        next unless defined $p->{$k};
        error(400, "$k: a number") unless $p->{$k} =~ /\A\d+(?:\.\d+)?\z/;
        $smp{$k} = 0 + $p->{$k};
    }
    for my $k (qw(top_k sub_top_k seed max_frames)) {
        next unless defined $p->{$k};
        error(400, "$k: a whole number") unless $p->{$k} =~ /\A\d+\z/;
        $smp{$k} = 0 + $p->{$k};
    }
    $smp{max_frames} = 2048 unless $smp{max_frames};
    error(400, 'max_frames: at most 8192') if $smp{max_frames} > 8192;
    my ($samples, $frames) = eval { $TTS->speak($input, voice => $v, language => $lang, %smp) };
    error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) if $@;
    my $wav = ROCm::Inference::speech_wav16($samples, 24000);
    $LOG->info('request', event => 'speech', msg => sprintf('%s: voice %s, %d frames, %.2f s', $tts_name, $voice, $frames,
                                                         length($samples) / 4 / 24000));
    return [ 200, [ 'Content-Type' => 'audio/wav' ], $wav ];
};

# A voice from audio (T7 of PLAN.md): a multipart body with the reference clip in the part "file" (a WAV file, 0.5 to 60 s),
# its transcript "ref_text" and the voice's name "name" (letters, digits, '-', '_', '.'). The clip is encoded to codec frames
# and its speaker embedding computed on the host; the voice is written to --voices/NAME (409 when it exists). The voice is
# then speech's "voice" value.
route::post '/v1/audio/voices' => sub {
    my ($req) = @_;
    error(503, 'no speech model: start the server with --tts TALKER.gguf --tts-codec CODEC.gguf --voices DIR', 'server_error')
        unless $TTS;
    error(503, 'no voices directory: start the server with --voices DIR') unless $o{voices};
    my $ct = $req->{headers}{'content-type'} // '';
    error(400, 'expected multipart/form-data with the clip in the part "file"') unless $ct =~ m{multipart/form-data}i;
    my $parts = eval { ROCm::Inference::Multipart::parse($req->{body}, $ct) }
        or error(400, 'bad multipart body: ' . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r));
    my $file = $parts->{file} or error(400, "'file' is required (a WAV file)");
    my $field = sub { my $p = $parts->{$_[0]} or return undef; (my $v = $p->{data}) =~ s/\A\s+|\s+\z//g; $v };
    my $name = $field->('name') // '';
    error(400, "name: letters, digits, '-', '_' or '.', not '$name'") unless $name =~ /\A[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}\z/
        && $name !~ /\.\./;
    my $ref_text = $field->('ref_text');
    error(400, "'ref_text' is required: the clip's transcript") unless defined $ref_text && length $ref_text;
    error(400, 'ref_text: at most 1000 characters') if length $ref_text > 1000;
    my $dir = "$o{voices}/$name";
    error(409, "voice '$name' exists") if -e $dir;
    my $samples = eval { ROCm::Inference::speech_wav_samples($file->{data}, 24000) }
        or error(400, 'the clip: ' . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r));
    my $seconds = length($samples) / 4 / 24000;
    error(400, 'the clip: 0.5 to 60 seconds of speech') if $seconds < 0.5 || $seconds > 60;
    my ($codes, $frames, $spk) = eval { $TTS->make_voice($samples) };
    error(400, 'the clip: ' . ($@ =~ s/ at \S+ line \d+\.?\n?\z//r)) if $@;
    ROCm::Inference::speech_voice_write($dir, { ref_text => $ref_text, frames => $frames, codes => $codes, spk => $spk });
    $LOG->info('request', event => 'voice', msg => sprintf('%s: %d frames, %.2f s, from a clip of %.2f s', $name, $frames, $seconds, $seconds));
    return { name => $name, frames => $frames, seconds => $seconds + 0 };
};

# the voices in --voices: their names, frames and transcripts
route::get '/v1/audio/voices' => sub {
    error(503, 'no voices directory: start the server with --voices DIR') unless $o{voices};
    opendir my $dh, $o{voices} or error(500, "--voices $o{voices}: $!");
    my @v;
    for my $n (sort grep { !/\A\./ } readdir $dh) {
        my $v = eval { ROCm::Inference::speech_voice("$o{voices}/$n") } or next;
        push @v, { name => $n, frames => $v->{frames}, ref_text => $v->{ref_text} };
    }
    closedir $dh;
    return { data => \@v };
};

# OpenAI's image generation: a JSON body with the prompt, the size (WIDTHxHEIGHT, multiples of 8 from 64 to 1024; 512x512 by
# default), n (1: one image per request) and response_format (b64_json: the PNG in base64 in data[0].b64_json; or png: the
# PNG bytes as image/png), the optional seed (the latents; 0 by default). One image at a time, on the host (about half a
# minute at 512 x 512 with sd-turbo's one step).
route::post '/v1/images/generations' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' or error(400, 'expected a JSON object (Content-Type: application/json)');
    # the model: minimax-h3-image (--minimax) or the sd-turbo file's name (--sd); with no model given, the first one started
    my $model = $p->{model} // ($MINIMAX ? 'minimax-h3-image' : $sd_name);
    my $backend;
    if ($MINIMAX && $model eq 'minimax-h3-image') { $backend = $MINIMAX; $model = 'minimax-h3-image' }
    elsif ($IMAGE && $model eq $sd_name)         { $backend = $IMAGE }
    else {
        error(503, 'no image model: start the server with --sd FILE.gguf or --minimax DIR', 'server_error') unless $IMAGE || $MINIMAX;
        error(400, "model: '$model' is not served (this server has " . join(' and ', grep { defined } ($sd_name, $MINIMAX ? 'minimax-h3-image' : undef)) . ')');
    }
    my $prompt = $p->{prompt};
    error(400, "'prompt' is required") unless defined $prompt && !ref $prompt && length $prompt;
    error(400, 'prompt: at most 1000 characters') if length $prompt > 1000;
    my $n = $p->{n} // 1;
    error(400, 'n: 1 (one image per request)') unless $n =~ /\A1\z/;
    my $size = $p->{size} // ($backend == $MINIMAX ? '1024x1024' : '512x512');
    error(400, "size: WIDTHxHEIGHT, not '$size'") unless $size =~ /\A\d+x\d+\z/;
    my $fmt = $p->{response_format} // 'b64_json';
    error(400, "response_format: b64_json or png, not '$fmt'") unless $fmt =~ /\A(?:b64_json|png)\z/;
    my $seed = $p->{seed} // 0;
    error(400, 'seed: a whole number') unless $seed =~ /\A\d+\z/;
    my $png = eval { $backend->generate($prompt, size => $size, seed => $seed) };
    error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) if $@;
    $LOG->info('request', event => 'image', msg => sprintf('%s: %s, seed %d, %d bytes of PNG', $model, $size, $seed, length $png));
    return [200, ['Content-Type' => 'image/png'], $png] if $fmt eq 'png';
    require MIME::Base64;
    return { created => time, data => [{ b64_json => MIME::Base64::encode_base64($png, '') }] };
};

route::post '/v1/chat/completions' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' or error(400, 'expected a JSON object (Content-Type: application/json)');
    my $r = pick($p, 'chat');
    my ($m, $name) = @$r{qw(m id)};
    my $q = request_ctx($req, $r);
    my $id = $q->{req};
    my @images;
    my ($messages, $opts) = (messages($p->{messages}, \@images), options($p, $r));
    if (@images) {
        # the images go to chat with the model's vision tower: its own prefill (no prefix reuse, no store)
        error(400, "$name has no vision tower: start the server with --mmproj") unless $r->{vision};
        error(400, 'images: not with --parallel > 1 (one conversation at a time: start with --parallel 1)') if $parallel > 1;
        @$opts{qw(images vision)} = (\@images, $r->{vision});
    }
    start_line($q, $p, $opts);
    my ($prompt_tokens, $completion_tokens, $prefill) = (undef, 0, undef);
    # the prompt's length is the sequence length when the first token comes; every token emitted counts
    # the reasoning's tokens and its close (the reply's own thinking section, when it has one), for tg/s by part
    my $close = reply_tags($m)->{reasoning}[1];
    $opts->{on_token} = sub {
        $prefill //= [ last_prompt_stats($m) ];
        $prompt_tokens //= n_past($m);
        if ($_[0] >= 0) {
            my $now = Time::HiRes::time();
            $q->{ttft} //= 1000 * ($now - $q->{t0});
            $q->{first_at} //= $now;
            ++$completion_tokens;
            if (!defined $q->{think_end}) {
                ++$q->{think_tok};
                $q->{tail} = substr(($q->{tail} // '') . detokenize($m, [ $_[0] ]), -64);
                $q->{think_end} = $now if index($q->{tail}, $close) >= 0;
            }
            gen_progress($q, $completion_tokens, $now);
        }
        # a plain JSON reply writes nothing until the end: the socket tells whether its client is still there
        if (!$q->{write} && $q->{client_gone} && Time::HiRes::time() - ($q->{gone_t} // 0) > 0.5) {
            $q->{gone_t} = Time::HiRes::time();
            if ($q->{client_gone}->()) {
                $LOG->warn_(log_fields($q), event => 'generation',
                            msg => "client gone after $completion_tokens tok of the reply: stopped");
                $q->{gone} = 1;
                return 1;
            }
        }
        # a keep-alive comment every 5 s while nothing else is written: a proxy keeps the connection, and a failed write
        # means the client has gone, so the reply stops (the true return)
        if ($q->{write} && Time::HiRes::time() - ($q->{last_write} // 0) > 5) {
            return 1 unless $q->{write}->(": keep-alive\n\n");
            $q->{last_write} = Time::HiRes::time();
        }
        0;
    };
    my $usage = sub {
        $prompt_tokens //= n_past($m);
        { prompt_tokens => $prompt_tokens, completion_tokens => $completion_tokens,
          total_tokens => $prompt_tokens + $completion_tokens };
    };

    return start_job($r, $id, $opts, $p, $q, messages => $messages) if $parallel > 1;

    unless ($p->{stream}) {
        local $r->{busy} = 1;
        local $r->{cur} = $q;
        my ($content, $why, $msg) = eval { chat($m, $messages, $opts) };
        # its client left (the prefill cancelled, or the reply stopped): nobody reads a reply; nginx logs 499 too
        error(499, 'client closed the request') if $q->{gone};
        error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) unless $msg;
        done_line($q, $usage->(), $prefill, finish_reason($why, $msg));
        my %out = (role => 'assistant', content => $content);
        $out{reasoning_content} = $msg->{reasoning_content} if defined $msg->{reasoning_content};
        $out{tool_calls} = tool_calls($msg) if $msg->{tool_calls};
        return { id => $id, object => 'chat.completion', created => time, model => $name,
                 choices => [ { index => 0, message => \%out, finish_reason => finish_reason($why, $msg) } ],
                 usage => $usage->() };
    }

    my $include_usage = ref $p->{stream_options} eq 'HASH' && $p->{stream_options}{include_usage};
    return stream(200, [ 'Content-Type' => 'text/event-stream' ], sub {
        my ($write) = @_;
        local $r->{busy} = 1;
        local $r->{cur} = $q;
        $q->{write} = $write;  # the event handler's liveness check (a keep-alive write)
        my $chunk = sub {
            my ($delta, $finish) = @_;
            $q->{last_write} = Time::HiRes::time();
            $write->(sse({ id => $id, object => 'chat.completion.chunk', created => time, model => $name,
                           choices => [ { index => 0, delta => $delta, finish_reason => $finish } ] }));
        };
        $chunk->({ role => 'assistant', content => '' }, undef) or return;
        my $gone = 0;
        my $ts = tool_stream_new();
        my ($content, $why, $msg) = eval {
            chat($m, $messages, { %$opts, on_delta => sub {
                my ($text, $kind) = @_;
                $q->{kind} = $kind;
                if ($kind eq 'tool_call') {  # the call as it is written: its name, then its arguments a parameter at a time
                    $q->{ts} = $ts;
                    for my $d (tool_stream_feed($ts, $text)) {
                        debug_stream($q, $kind, $d);
                        $gone = 1 unless $chunk->({ tool_calls => [ $d ] }, undef);
                    }
                    return $gone;
                }
                debug_stream($q, $kind, $text);
                $gone = 1 unless $chunk->({ ($kind eq 'reasoning' ? 'reasoning_content' : 'content') => $text }, undef);
                return $gone;
            } });
        };
        return if $gone;
        done_line($q, $usage->(), $prefill, finish_reason($why, $msg)) if $msg;
        unless ($msg) {
            $write->(sse({ error => { message => $@ =~ s/ at \S+ line \d+\.?\n?\z//r, type => 'server_error' } }));
            return;
        }
        my @calls = $msg->{tool_calls} ? @{ tool_calls($msg) } : ();
        if (defined $ts->{name}) {  # the first call was streamed: its end, then any further call whole
            $chunk->({ tool_calls => [ tool_stream_end($ts) ] }, undef) or return;
            for my $i (1 .. $#calls) { $chunk->({ tool_calls => [ { index => $i, %{ $calls[$i] } } ] }, undef) or return }
        } elsif (@calls) {
            $chunk->({ tool_calls => [ map { { index => $_, %{ $calls[$_] } } } 0 .. $#calls ] }, undef) or return;
        }
        $chunk->({}, finish_reason($why, $msg)) or return;
        $write->(sse({ id => $id, object => 'chat.completion.chunk', created => time, model => $name, choices => [],
                       usage => $usage->() })) or return if $include_usage;
        $write->(sse('[DONE]'));
    });
};

# POST /v1/completions (OpenAI's raw completions): the prompt text as it is, no chat template and no reasoning split,
# tokenized as chat's text is (with the BOS the model wants) and continued by the model; the reply is plain text,
# choices[].text. With --parallel, a job of the loop as a chat is (a raw stream in its sequence).
route::post '/v1/completions' => sub {
    my ($req) = @_;
    my $p = $req->{json};
    ref $p eq 'HASH' or error(400, 'expected a JSON object (Content-Type: application/json)');
    my $r = pick($p, 'chat');
    my ($m, $name) = @$r{qw(m id)};
    error(400, "'prompt' is a string: the text the model continues") if !defined $p->{prompt} || ref $p->{prompt};
    my $q = request_ctx($req, $r);
    my $id = $q->{req} =~ s/^chatcmpl-/cmpl-/r;
    $q->{req} = $id;  # (the log lines' request id as the response's)
    my $opts = options($p, $r);
    delete @$opts{qw(vars max_thinking_tokens)};
    start_line($q, $p, $opts);
    my $ids = tokenize($m, $p->{prompt});
    return start_job($r, $id, $opts, $p, $q, prompt => $ids) if $parallel > 1;
    my ($completion, $text, $write) = (0, '');
    my $usage = sub {
        { prompt_tokens => scalar @$ids, completion_tokens => $completion, total_tokens => @$ids + $completion };
    };
    my $on_token = sub {
        my ($tok, $piece) = @_;
        my $now = Time::HiRes::time();
        if ($tok >= 0 && !token_is_eog($m, $tok)) {
            $q->{first_at} //= $now;
            $q->{ttft} //= 1000 * ($now - $q->{t0});
            ++$completion;
            $piece //= '';
            $text .= $piece;
            if ($write) {
                $q->{last_write} = $now;
                return 1 unless $write->(sse({ id => $id, object => 'text_completion', created => time, model => $name,
                                               choices => [ { index => 0, text => $piece, logprobs => undef, finish_reason => undef } ] }));
            }
            gen_progress($q, $completion, $now);
        }
        # a keep-alive comment every 5 s while a stream writes nothing else; a plain reply checks the socket for a client
        # that has gone (the true return stops the generation, as chat's does)
        if ($write) {
            if ($now - ($q->{last_write} // 0) > 5) {
                return 1 unless $write->(": keep-alive\n\n");
                $q->{last_write} = $now;
            }
        } elsif ($q->{client_gone} && $now - ($q->{gone_t} // 0) > 0.5) {
            $q->{gone_t} = $now;
            if ($q->{client_gone}->()) {
                $LOG->warn_(log_fields($q), event => 'generation',
                            msg => "client gone after $completion tok of the reply: stopped");
                $q->{gone} = 1;
                return 1;
            }
        }
        0;
    };
    my %g = (%$opts, reuse_prefix => 1, on_token => $on_token);

    unless ($p->{stream}) {
        local $r->{busy} = 1;
        local $r->{cur} = $q;
        my (undef, $why) = eval { generate($m, $ids, \%g) };
        # its client left: nobody reads a reply; nginx logs 499 too
        error(499, 'client closed the request') if $q->{gone};
        error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) unless defined $why;
        done_line($q, $usage->(), undef, finish_reason($why, {}));
        return { id => $id, object => 'text_completion', created => time, model => $name,
                 choices => [ { index => 0, text => $text, logprobs => undef, finish_reason => finish_reason($why, {}) } ],
                 usage => $usage->() };
    }

    my $include_usage = ref $p->{stream_options} eq 'HASH' && $p->{stream_options}{include_usage};
    return stream(200, [ 'Content-Type' => 'text/event-stream' ], sub {
        ($write) = @_;
        local $r->{busy} = 1;
        local $r->{cur} = $q;
        $q->{write} = $write;
        my (undef, $why) = eval { generate($m, $ids, \%g) };
        if (!defined $why) {
            $write->(sse({ error => { message => $@ =~ s/ at \S+ line \d+\.?\n?\z//r, type => 'server_error' } }));
            return;
        }
        return if $q->{gone};  # its client left: no end to write
        done_line($q, $usage->(), undef, finish_reason($why, {}));
        $write->(sse({ id => $id, object => 'text_completion', created => time, model => $name,
                       choices => [ { index => 0, text => '', logprobs => undef, finish_reason => finish_reason($why, {}) } ] }))
            or return;
        $write->(sse({ id => $id, object => 'text_completion', created => time, model => $name, choices => [],
                       usage => $usage->() })) or return if $include_usage;
        $write->(sse('[DONE]'));
    });
};

# ---- --parallel: conversations at once. A request becomes a job of its model: it waits for a free sequence (the
# one whose last prompt shares the most tokens with its prompt, for prefix reuse), then each round of the server's
# loop (tick) advances every running job by one token, a model's all in one forward pass (batched decoding); its
# response pulls what the job produced (SSE events, or the JSON at the end). A client that leaves cancels its job.

# A job for this request (a chat: messages => \@messages; a raw completion: prompt => \@ids); the response pulls its
# output
sub start_job {
    my ($r, $id, $opts, $p, $q, %what) = @_;
    $opts = { %$opts, prefill_chunk => $o{'prefill-chunk'} // 512 };
    delete $opts->{on_token};  # (a step gives the job its tokens)
    my $job = { r => $r, id => $id, opts => $opts, stream => $p->{stream} ? 1 : 0, out => [],
                q => $q, queued => Time::HiRes::time(), completion => 0,
                usage_chunk => ref $p->{stream_options} eq 'HASH' && $p->{stream_options}{include_usage} };
    if ($what{messages}) {
        my %vars = %{ $opts->{vars} // {} };
        my $text = eval { chat_render($r->{m}, $what{messages}, %vars) };  # template errors are this request's (400), now
        error(400, $@ =~ s/ at \S+ line \d+\.?\n?\z//r) unless defined $text;
        @$job{qw(messages prompt)} = ($what{messages}, tokenize($r->{m}, $text));
    } else {
        @$job{qw(raw prompt)} = (1, $what{prompt});
    }
    push @{ $r->{queue} }, $job;
    if ($job->{stream} && !$job->{raw}) {
        push @{ $job->{out} }, chunk($job, { role => 'assistant', content => '' }, undef);
    }
    my $type = $job->{stream} ? 'text/event-stream' : 'application/json';
    return pull(200, [ 'Content-Type' => $type ], sub {
        return join '', splice @{ $job->{out} } if @{ $job->{out} };
        return $job->{done} ? undef : '';
    }, on_close => sub { cancel($job) });
}

# A streamed piece of the job's reply: a chat's delta, or (a raw job) the delta's content as choices[].text
sub chunk {
    my ($job, $delta, $finish) = @_;
    return sse({ id => $job->{id}, object => 'text_completion', created => time, model => $job->{r}{id},
                 choices => [ { index => 0, text => $delta->{content} // '', logprobs => undef, finish_reason => $finish } ] })
        if $job->{raw};
    return sse({ id => $job->{id}, object => 'chat.completion.chunk', created => time, model => $job->{r}{id},
                 choices => [ { index => 0, delta => $delta, finish_reason => $finish } ] });
}

# A raw completion as the loop runs a chat: stream_begin on the job's sequence, stepped by step_chats with the chats
# (its _took as ROCm::Inference::ChatStream's: the step's text as a content delta, and whether it goes on)
{
    package RawStream;
    sub new {
        my ($class, $m, $ids, $opts) = @_;
        return bless { m => $m, n => 0, prompt_n => scalar @$ids, text => '',
                       stream => ROCm::Inference::stream_begin($m, $ids, { reuse_prefix => 1, %$opts }) }, $class;
    }
    sub _took {
        my ($c, $tok, $text, $going, $why) = @_;
        $c->{reason} = $why;
        ++$c->{n} if $tok >= 0 && !ROCm::Inference::token_is_eog($c->{m}, $tok);
        $c->{text} .= $text if length $text;
        if (!$going) { $c->{done} = 1; $c->{stream}->free }
        return (length $text ? [ [ $text, 'content' ] ] : [], !$c->{done});
    }
    sub tokens { $_[0]{n} }
    sub prompt_tokens { $_[0]{prompt_n} }
    sub result { my ($c) = @_; return unless $c->{done}; return ($c->{text}, $c->{reason}, { content => $c->{text} }) }
}

sub release {
    my ($job) = @_;
    my $r = $job->{r};
    my ($slot) = grep { ($_->{job} // 0) == $job } @{ $r->{pool} };
    $slot->{job} = undef if $slot;
    $r->{running} = [ grep { $_ != $job } @{ $r->{running} } ];
    $r->{queue} = [ grep { $_ != $job } @{ $r->{queue} } ];
}

sub cancel {
    my ($job) = @_;
    if (my $q = !$job->{done} && $job->{q}) {  # (its client left: Web::Route's on_close)
        my $where = !$job->{chat} ? 'while queued'
                  : $job->{completion} ? "after $job->{completion} tok of the reply"
                  : sprintf('during the prefill, after %d of %d tok', $q->{prefill_at} // 0, $q->{pf_total} // 0);
        $LOG->warn_(log_fields($q), event => 'cancel', msg => "client gone $where: cancelled");
        $LOG->progress_end($q->{req}) if $q->{req};
    }
    $job->{done} = 1;
    $job->{chat} = undef;  # frees its stream
    release($job);
}

sub common_prefix {
    my ($a, $b) = @_;
    my $n = 0;
    ++$n while $n < @$a && $n < @$b && $a->[$n] == $b->[$n];
    return $n;
}

# The job's reply so far as events, or (done) its response
sub job_output {
    my ($job, $deltas) = @_;
    # a keep-alive comment when nothing has been sent for 5 s (the pull is the client's liveness: see on_close)
    my $now = Time::HiRes::time();
    $job->{last_out} //= $now;
    if (@$deltas) { $job->{last_out} = $now }
    elsif ($job->{stream} && !$job->{finished} && $now - $job->{last_out} > 5) {
        push @{ $job->{out} }, ": keep-alive\n\n";
        $job->{last_out} = $now;
    }
    my $q = $job->{q} // {};
    # the first token: the reply begins
    if ($job->{completion} > 0 && !$q->{first_at}) {
        $q->{ttft} = 1000 * ($now - $q->{t0}) if $q->{t0};
        $q->{first_at} = $now;
    }
    # the reply's phases (as the sequential path tracks them, for the progress lines and the done line's tg/s split)
    my $ts = $job->{ts} //= tool_stream_new();
    for my $d (@$deltas) {
        my ($text, $kind) = @$d;
        $q->{saw_reasoning} = 1 if $kind eq 'reasoning';
        if ($kind ne 'reasoning' && $q->{saw_reasoning} && !defined $q->{think_end}) {
            $q->{think_end} = $now;
            $q->{think_tok} = $job->{completion};
        }
        $q->{kind} = $kind;
        if ($kind eq 'tool_call') {  # streamed as it is written (see tool_stream_feed)
            $q->{ts} = $ts;
            for my $p (tool_stream_feed($ts, $text)) {
                debug_stream($q, $kind, $p);
                push @{ $job->{out} }, chunk($job, { tool_calls => [ $p ] }, undef) if $job->{stream};
            }
            next;
        }
        debug_stream($q, $kind, $text);
        push @{ $job->{out} }, chunk($job, { ($kind eq 'reasoning' ? 'reasoning_content' : 'content') => $text }, undef)
            if $job->{stream};
    }
    gen_progress($q, $job->{completion}, $now) unless $job->{finished};
    return unless $job->{finished};
    my ($content, $why, $msg) = @{ $job->{finished} };
    done_line($q, { prompt_tokens => $job->{prompt_tokens} // 0, completion_tokens => $job->{completion} }, $job->{prefill},
              finish_reason($why, $msg)) if $job->{q};
    my %usage = (prompt_tokens => $job->{prompt_tokens} // 0, completion_tokens => $job->{completion},
                 total_tokens => ($job->{prompt_tokens} // 0) + $job->{completion});
    if ($job->{stream}) {
        my @calls = $msg->{tool_calls} ? @{ tool_calls($msg) } : ();
        if (defined $job->{ts}{name}) {
            push @{ $job->{out} }, chunk($job, { tool_calls => [ tool_stream_end($job->{ts}) ] }, undef);
            push @{ $job->{out} }, chunk($job, { tool_calls => [ { index => $_, %{ $calls[$_] } } ] }, undef) for 1 .. $#calls;
        } elsif (@calls) {
            push @{ $job->{out} }, chunk($job, { tool_calls => [ map { { index => $_, %{ $calls[$_] } } } 0 .. $#calls ] }, undef);
        }
        push @{ $job->{out} }, chunk($job, {}, finish_reason($why, $msg));
        push @{ $job->{out} }, sse({ id => $job->{id}, object => $job->{raw} ? 'text_completion' : 'chat.completion.chunk',
                                     created => time, model => $job->{r}{id}, choices => [], usage => \%usage })
            if $job->{usage_chunk};
        push @{ $job->{out} }, sse('[DONE]');
    } elsif ($job->{raw}) {
        push @{ $job->{out} }, $J->encode({ id => $job->{id}, object => 'text_completion', created => time,
            model => $job->{r}{id}, usage => \%usage,
            choices => [ { index => 0, text => $content, logprobs => undef, finish_reason => finish_reason($why, $msg) } ] });
    } else {
        my %out = (role => 'assistant', content => $content);
        $out{reasoning_content} = $msg->{reasoning_content} if defined $msg->{reasoning_content};
        $out{tool_calls} = tool_calls($msg) if $msg->{tool_calls};
        push @{ $job->{out} }, $J->encode({ id => $job->{id}, object => 'chat.completion', created => time,
            model => $job->{r}{id}, choices => [ { index => 0, message => \%out, finish_reason => finish_reason($why, $msg) } ],
            usage => \%usage });
    }
    $job->{done} = 1;
}

sub job_error {
    my ($job, $err) = @_;
    $err =~ s/ at \S+ line \d+\.?\n?\z//;
    push @{ $job->{out} }, $job->{stream} ? sse({ error => { message => $err, type => 'server_error' } })
                                          : $J->encode({ error => { message => $err, type => 'server_error' } });
    $job->{done} = 1;
    release($job);
}

# One round: for every loaded model, start what waits (free sequences), then one token for each of its running jobs
sub tick {
    my $n = 0;
    for my $r (grep { $_->{m} } values %M) {
        my $m = $r->{m};
        while (@{ $r->{queue} }) {
            my @free = grep { !$_->{job} } @{ $r->{pool} } or last;
            my $job = shift @{ $r->{queue} };
            my ($slot) = sort { common_prefix($b->{prompt}, $job->{prompt}) <=> common_prefix($a->{prompt}, $job->{prompt}) } @free;
            $slot->{job} = $job;
            $slot->{prompt} = $job->{prompt};
            seq_select($m, $slot->{seq});
            {
                local $r->{cur} = $job->{q};  # (its events: the prompt synced with the sequence, the store's blocks)
                $job->{chat} = eval { $job->{raw} ? RawStream->new($m, $job->{prompt}, $job->{opts})
                                                  : chat_start($m, $job->{messages}, $job->{opts}) };
            }
            $job->{q}{queued_ms} = 1000 * (Time::HiRes::time() - $job->{queued}) if $job->{q};
            if (!$job->{chat}) { job_error($job, $@); next }
            $job->{prompt_tokens} = $job->{chat}->prompt_tokens;
            # what the prompt reuses from the sequence and the store, and what the steps prefill (a chunk each)
            $job->{prefill} = [ last_prompt_stats($m) ];
            if (my $q = $job->{q}) {
                $q->{chunked} = 1;
                $q->{pf_total} = $job->{prefill}[1];
                $LOG->debug('prefill', log_fields($q), event => 'prompt',
                            msg => sprintf('prompt %d tok: %d reused, %d to prefill in chunks of %d, seq %d',
                                           $job->{prompt_tokens}, @{ $job->{prefill} }, $job->{opts}{prefill_chunk}, $slot->{seq}));
            }
            push @{ $r->{running} }, $job;
        }
        next unless @{ $r->{running} };
        # one forward pass for all of them (batched decoding)
        my @jobs = @{ $r->{running} };  # (a job that ends leaves running)
        my @res = eval { step_chats(map { $_->{chat} } @jobs) };
        if (!@res) {
            my $err = $@;
            job_error($_, $err) for @jobs;
            next;
        }
        for my $i (0 .. $#jobs) {
            my $job = $jobs[$i];
            my ($deltas, $going) = @{ $res[$i] };
            $job->{completion} = $job->{chat}->tokens;
            if (!$going) {
                $job->{finished} = [ $job->{chat}->result ];
                $job->{chat} = undef;
                release($job);
            }
            job_output($job, $deltas);
        }
        $n += @{ $r->{running} };
    }
    return $n;
}

if ($o{'models-dir'}) {
    my @ids = sort keys %M;
    $LOG->info('model', event => 'serve', msg => join(' ', "serving", scalar @ids, "models from $o{'models-dir'} on $o{listen}",
        ($parallel > 1 ? ", $parallel conversations at once per model" : ''), ": @ids"));
} elsif (my $r = $default{chat} // $default{embedding}) {
    $LOG->info('model', model => $r->{id}, event => 'serve', msg => "serving on $o{listen}: context $r->{ctx} tokens (trained $r->{info}{n_ctx_train})" .
        ($parallel > 1 ? ", $parallel conversations at once" : ''));
} else {
    $LOG->info('model', event => 'serve', msg => "serving on $o{listen}: no chat model" .
        ($WHISPER ? ", speech model $whisper_name" : '') . ($TTS ? ", speech synthesis $tts_name" : '') . ($IMAGE ? ", images $sd_name" : ''));
}
run(listen => $o{listen}, log => $LOG->enabled('info') ? \&access_line : 0, defined $o{mode} ? (mode => oct $o{mode}) : (),
    $parallel > 1 ? (tick => \&tick) : ());

# SIGINT / SIGTERM: the stores closed before the exit, so that the snapshots held in memory (--store-snapshots lazy)
# are written (the exit's own clean-up runs in no set order)
if ($o{store}) {
    for my $r (grep { $_->{m} } values %M) {
        my $held = store_stats($r->{m})->{snapshots_held};
        my $saved = store_stats($r->{m})->{snapshots_saved};
        eval { store_close($r->{m}); 1 } or $LOG->warn_(model => $r->{id}, event => 'store', msg => "close failed: $@");
        $LOG->info('store', model => $r->{id}, event => 'close', msg => "KV store closed (snapshots: $saved written, $held held)");
    }
}


__END__

=head1 NAME

rocm-inference-server - an OpenAI-compatible chat server for one model or a directory of them, behind nginx

=head1 SYNOPSIS

    rocm-inference-server --model /models/Qwen3.5-4B-ROCMFP4.gguf --listen /run/llm/llm.sock --mode 0660

    curl --unix-socket /run/llm/llm.sock http://x/v1/chat/completions -H 'Content-Type: application/json' \
         -d '{"messages": [{"role": "user", "content": "Hi!"}], "stream": true}'

    # every model in /models, each loaded when a request names it
    rocm-inference-server --models-dir /models --listen /run/llm/llm.sock --mode 0660
    curl --unix-socket /run/llm/llm.sock http://x/v1/models
    curl --unix-socket /run/llm/llm.sock http://x/v1/chat/completions -H 'Content-Type: application/json' \
         -d '{"model": "Qwen3.6-35B-A3B-ROCMFP4", "messages": [{"role": "user", "content": "Hi!"}]}'

=head1 OPTIONS

=over

=item --model F<file.gguf>

The model (the first shard of a split one), loaded at start; it stays loaded. An embedding model (EmbeddingGemma)
serves C</v1/embeddings> only. This or C<--models-dir> (or both) is required.

=item --models-dir F<dir>

Serve the models in F<dir>: every GGUF this engine runs (chat and embedding models; a split one by its
F<-00001-of-0000N> file; not other files, shards, mmproj or imatrix files), listed by C<GET /v1/models> with the
file name without F<.gguf> as id. None is loaded at start: a request loads the model its C<model> names (a load from
the page cache or a tmpfs takes a few seconds; from a cold disk what the disk gives), and a model is unloaded when
another needs the room (C<--models-max>, C<--models-margin>), least recently used first, never one that serves a
request. The directory is read again when the list is asked for, so files added or removed show. A model's own MTP
block, else a draft (MTP) head in the directory, is used for the model it fits (Qwen3.8-Flash-Next; not with
C<--parallel>). Each model gets the
context and KV cache type C<--ctx> / C<--kv-type> give, by default from its own trained context (C<--kv-budget>).

=item --models-max N

With C<--models-dir>: at most N models loaded at once (default: as many as fit).

=item --models-margin GB

With C<--models-dir>: memory to leave free (default 4). A model is loaded when its files and KV cache fit in
MemAvailable less this margin (and less the files of the models loaded already, whose pinned pages the kernel
counts as reclaimable); before that, idle models are unloaded. Programs next to the server (llama-server) count
with what they hold.

=item --embedding-model F<file.gguf>, --embedding-name NAME

An embedding model next to the chat model, for C</v1/embeddings> (its name in C</v1/models>: the file's, unless
given).

=item --listen F<path> | host:port

Where to listen: a unix socket (default F<./rocm-inference.sock>) or host:port.

=item --mode 0660

The socket file's permissions (nginx's user must be able to write to it).

=item --ctx N

Context length per conversation, for every model (each conversation's KV cache is this long: C<--parallel> N
takes N times the memory). Default: each model's trained context, unless its KV caches would take more than
C<--kv-budget>: then the longest context that fits (in steps of 256). An embedding model takes at most 2048.

=item --kv-budget GB

Without C<--ctx>: the most a model's KV caches (all its C<--parallel> conversations together) may take
(default 16). Qwen3.8-Flash-Next and Qwen3.6-35B get their whole 262144 positions (3.4 / 3.1 GB as Q8_0),
Nemotron-3 its 1048576 (4.5 GB); Gemma-4 26B (215 KB a position before its sliding-window ring) 150272.

=item --stage F<dir>

Copy the model's GPU tensors to a stage file in F<dir> (a huge-page tmpfs such as F</dev/shm>) and run from there
(C<load_model>'s C<stage>): later starts reuse it and pin in a fraction of the time.

=item --recache

Read the model file again into the page cache before using it: dropped first, then read as 2 MB pages, which the
GPU reads the weights through with fewer TLB misses (a 27B BF16 model's short prompts +35-45%). Worth it once when
the startup line C<model memory: X of Y MB on 2 MB pages> shows few (the file was cached as 4 KB pages, e.g. read
by another program first); the pages stay cached that way for later starts. Costs one read of the file from disk.

=item --kv-type auto|f16|q8_0|q4_0

The KV cache's element type (C<set_kv_type>). C<q8_0> takes about half the memory of C<f16> and decodes faster
at long contexts (fewer bytes read per token); C<q4_0> takes about a quarter, less exactly. C<auto>, the default, takes C<q8_0> for a C<--ctx> of 32768 or
more and C<f16> below that, or where the model's cache rows do not suit C<q8_0> (a multiple of 256 values).

=item --parallel N

Serve N conversations at once (default 1): N sequences, each its own KV cache of C<--ctx> positions (N times the
memory). Every round of the server's loop advances each running conversation by one token, all in one forward pass
(batched decoding: 8 conversations get about 3.5 times the tokens per second of one); a request waits for a
free sequence, preferably the one whose last prompt shares the most tokens with it (prefix reuse; with C<--store>
any sequence resumes from the store's blocks). A new prompt is prefilled C<--prefill-chunk> tokens per round, so the
running conversations go on meanwhile. Not with C<--draft>.

=item --prefill-chunk N

With C<--parallel>: tokens of a new prompt prefilled per round of the server's loop (default 512). Smaller: the
other conversations slow down less while a long prompt comes in; larger: the prompt is in sooner.

=item --swa-ring N

Models with sliding-window attention (Gemma-4): the KV cache of those layers as a ring of at least N positions
(C<set_swa_ring>): -1 (the default) the smallest that works, a few thousand positions; larger keeps more history
for reusing a conversation's prefix; 0 no ring, every layer's whole history (the default with C<--store>, which
needs it). At 128k context about 3 GB instead of 31 GB for Gemma-4 26B-A4B.

=item --name NAME

The model id in the API (default: the file name without F<.gguf>).

=item --mmproj F<mmproj.gguf>

The vision tower (C<rocm-convert --mmproj> of a Qwen3.5 checkpoint) for images in chat requests: a message's content
parts of type C<image_url> take a C<data:image/...;base64,...> URL (the server does not fetch URLs). Its output must be
the model's width (else the model answers without images, with a warning). Not with C<--parallel> above 1.

=item --whisper F<whisper.gguf>

A speech model (C<rocm-convert> of a Whisper checkpoint, e.g. openai/whisper-tiny) for C</v1/audio/transcriptions>.
Runs on the host (not the GPU), one request at a time. A server with only this option needs no chat model.

=item --draft F<file.gguf> | none

An MTP draft head for speculative decoding (Qwen3.8-Flash-Next). Without it (and without C<--parallel>), a model
whose file carries its own MTP block (converted from the BF16 release with it, C<blk.N.nextn.*>) drafts with that
block, which costs no memory but its one-layer KV cache; C<none>: no draft head.

=item --store F<dir>

A KV block store (e.g. under F</dev/shm>): prompt prefixes are reused across conversations and restarts. On tmpfs a
block is published by a link (no copy), but the store is RAM that nothing evicts without swap: with a large model,
keep C<--store-max> small. On a disk the KV cache stays in F</dev/shm> and each block is copied in (a warning at the
start says so). After each load the server warns when the loaded models, their KV caches and a store in memory leave
too little RAM for the page cache (see the C<memory> log line).

=item --store-max GB

The most the store may hold (default 16 GB): after each request the least recently used blocks are deleted to stay under
it. Deleting a block a sequence maps is safe; a block that is needed again is prefilled again.

=item --store-snapshots lazy|eager

When a recurrent model's state is saved at the end of each prompt (hybrid models such as Qwen3.5 / 3.6: 62.8 MB on
Qwen3.6-35B-A3B). C<lazy> (the default): held in memory, one per conversation slot, and written only when the
conversation leaves its sequence (another conversation takes it, or the server stops): a conversation that goes on
writes none. C<eager>: written at every prompt's end (the previous one of the same conversation is deleted). A crash
loses a held one: a resume then starts from the deepest spaced snapshot.

=item --store-snapshot-every N

The spacing of the other snapshots, in blocks (default 4; 0: prompt ends only): every N-th block over the first 16 x N,
then half as dense with each doubling of the depth. A prompt that leaves a stored conversation resumes from the
deepest one before that point.

=item --max_tokens N

The most tokens a reply may have (0, the default: no limit of its own). A request's C<max_tokens> /
C<max_completion_tokens> is honoured up to it; without one a reply goes on until it ends or the context is full
(C<finish_reason> C<length>).

=item --[no]thinking

Thinking on or off when a request does not say (default: the chat template's default).

=item --[no]preserve-thinking

Render the reasoning of every earlier assistant message (the template variable C<preserve_thinking>; default on; a
request's C<chat_template_kwargs> decides for itself). Qwen3.6's template otherwise drops it from the messages before
the last user message, so each new user message changes the rendering of the whole previous turn, and all of it is
prefilled again (an agent's turn: its tool calls and results, often 10-20k tokens). The prompt keeps the reasoning
the client sends back (C<reasoning_content>), so it is longer. Templates without the variable ignore it.

=item --[no]log

The log on STDERR, one line per event: a request's start and done (prompt tokens, reused from the cache and prefilled,
the reply, the times), the prefill's progress, model loads and unloads, the access line of each request. Off with
C<--nolog> (the same as C<--log-level none>).

=item --thinking-low N, --thinking-medium N, --thinking-high N

The thinking budget (tokens of reasoning, then the answer) for a request's C<reasoning_effort> low, medium and high,
when the request gives no budget of its own. 0 is no limit; the defaults are 2048, 8192 and no limit. C<none> and
C<minimal> turn thinking off, as before.

=item --[no]debug-stream

Logs every delta the server sends a client (its text as JSON, and each tool call piece) at the info level, so the
stream can be checked; with C<--parallel> too (a plain JSON reply's pieces as well, which are not streamed).

A client that leaves stops its request: during the prefill (an event stream: the keep-alive write fails; a plain JSON
request: the socket shows it closed), or during the reply. With C<--parallel>, the job is dropped between rounds (a
prompt in chunks: between them). The log says where it stopped.

=item --log-level error|warn|info|debug|none

What is written: C<info> (the default) has the requests and the loads; C<debug> adds the prefill starts, the
checkpoints and stores, the draft passes; C<warn> and C<error> only the problems.

=item --log-format text|json

Text: fixed columns (time, pid, level, user, client, conversation, request, model, event, message). Json: one object
per line, the same fields.

=item --log-color auto|always|never

Colours by kind on a terminal (auto; off with NO_COLOR), always, or never.

Who a line is for: the user (nginx's X-Remote-User), the client (X-Real-IP, or X-Forwarded-For), the conversation (the
X-LLamaCPP-Id-slot header of the opencode fixups). See L<ROCm::Inference::Log>.

=back

=head1 API

C<POST /v1/audio/transcriptions> (with C<--whisper>): a C<multipart/form-data> body with the audio in the part C<file>
(a WAV: PCM 8, 16, 24 or 32 bits, or 32-bit float, any channels and rate; any length: clips over 30 s are transcribed in
windows, each cut at a quiet point), and the parts C<language> (a code such as C<en>, the default; the model's languages),
C<task> (C<transcribe>, the default, or C<translate>: into English) and C<response_format> (C<json>, the default,
C<{"text": ...}>; or C<text>, the plain text). C<model> is accepted and ignored. The text has no leading or trailing space.

C<GET /health>, C<GET /v1/models>, C<GET /v1/models/{id}> and C<POST /v1/chat/completions>, as OpenAI's:
C<messages> (text content, images as C<image_url> parts with a data: URL with C<--mmproj>; tool calls and tool
results), C<tools>, C<tool_choice> (C<none> drops the tools),
C<max_tokens> / C<max_completion_tokens>, C<temperature>, C<top_p>, C<seed>, C<stop>, C<stream> and
C<stream_options.include_usage>. A reply's reasoning comes as C<reasoning_content> (in C<message> or in the
streamed C<delta>s), its tool calls as C<tool_calls> (with arguments as a JSON string) and C<finish_reason>
C<tool_calls>. Beyond OpenAI's: C<top_k>, C<min_p>, C<repeat_penalty>, C<presence_penalty>, C<repeat_last_n>, C<chat_template_kwargs> (template
variables, e.g. C<{"enable_thinking": false}>), C<reasoning_effort> (C<none> / C<minimal> turn thinking off),
C<max_thinking_tokens> (or C<thinking_budget_tokens>): close the reasoning after that many tokens.

C<POST /v1/completions> is OpenAI's raw completion: C<prompt> (a string) is continued as it is, with no chat template
and no reasoning split; the reply is plain text in C<choices[].text>. It takes C<max_tokens>, C<temperature>, C<top_p>,
C<seed>, C<stop> and C<stream> as chat does. With C<--parallel>, a raw completion is a conversation of the N, as a
chat is.

C<model> picks the model: with C<--models-dir> one from C<GET /v1/models> (loaded when needed; an unknown one is a
404), none: the one used last (or the only one); with C<--model> alone any name gets that model. C<GET /v1/models>
lists each with C<status.value> (C<loaded> / C<unloaded>), C<kind> (C<chat> / C<embedding>), C<arch>,
C<context_length> (what it gets), C<n_ctx_train> and C<bytes>. As llama.cpp's router: C<POST /models/load> and
C<POST /models/unload> with C<{"model": id}> load a model now or unload one (409 while it serves a request).

C<POST /v1/embeddings> (with an embedding model), as OpenAI's: C<input> (a string, an array of strings, an array
of token ids or an array of those), C<encoding_format> (C<float> or C<base64>), C<dimensions> (the leading values,
renormalized: Matryoshka), C<usage.prompt_tokens>. Embeddings are normalized to length 1, as llama-server's; an
input longer than the embedding model's context (2048 tokens at most) is an error (400).

Requests are served one at a time (with C<--parallel> N, N per model at once); a model keeps its last
conversation, so its next turn only prefills what is new (C<--store> extends that to every conversation, of every
model). A client that disconnects stops its reply.

=head1 NGINX

    upstream llm { server unix:/run/llm/llm.sock; }
    server {
        listen 443 ssl;
        location /v1/ {
            proxy_pass http://llm;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_read_timeout 900s;
            client_max_body_size 16m;
        }
    }

=cut
